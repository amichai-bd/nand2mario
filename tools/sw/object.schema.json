{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nand2mario relocatable object v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "sections",
    "symbols",
    "exports",
    "imports",
    "relocations",
    "listing"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/definition"
      }
    },
    "exports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "imports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "relocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relocation"
      }
    },
    "listing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/listing"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "data",
        "size",
        "span"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ROM",
            "RAM"
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "span"
      ],
      "properties": {
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name"
          ],
          "properties": {
            "op": {
              "const": "symbol"
            },
            "name": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "section",
            "offset"
          ],
          "properties": {
            "op": {
              "const": "address"
            },
            "section": {
              "type": "string"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "+",
                "-",
                "~",
                "*",
                "/",
                "<<",
                ">>",
                "&",
                "^",
                "|",
                "LOW",
                "HIGH"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    },
    "relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "section",
        "offset",
        "expression",
        "minimum",
        "maximum",
        "mask",
        "shift",
        "bias",
        "allowed",
        "span"
      ],
      "properties": {
        "kind": {
          "enum": [
            "U8",
            "U16LE",
            "ADDR16LE",
            "REL8",
            "HIGH8",
            "LOW8"
          ]
        },
        "section": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "minimum": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 65535
        },
        "maximum": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 65535
        },
        "mask": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "shift": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "bias": {
          "type": "integer",
          "minimum": -65535,
          "maximum": 65535
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "offset",
        "size",
        "instruction",
        "span"
      ],
      "properties": {
        "section": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "instruction": {
          "type": "boolean"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    }
  }
}
