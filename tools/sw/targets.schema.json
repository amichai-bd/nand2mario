{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nand2mario assembler target registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "directory",
          "sources",
          "assets"
        ],
        "properties": {
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assets": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
