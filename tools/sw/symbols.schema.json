{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nand2mario symbols v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "symbols"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "unit",
          "symbol",
          "value",
          "visibility"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "integer"
          },
          "visibility": {
            "enum": [
              "export",
              "local"
            ]
          }
        }
      }
    }
  }
}
