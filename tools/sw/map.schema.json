{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nand2mario map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "section",
          "kind",
          "region",
          "address",
          "size",
          "file_offset"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "ROM",
              "RAM"
            ]
          },
          "region": {
            "enum": [
              "ROM0",
              "ROM1",
              "VRAM",
              "WRAM",
              "OAM",
              "HRAM"
            ]
          },
          "address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "file_offset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
