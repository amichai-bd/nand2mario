`verilator_config
// Lint waivers for warnings the serial testbenches induce in src/rtl.
// Each waiver names the rule, the RTL file and signal, and the testbench
// construct that causes the report. RTL lint comments stay reserved for
// warnings the RTL itself owns. A comment here must not open with the word
// "verilator": the lexer would read it as a lint meta-comment.

// MULTIDRIVEN: tb_serial_registers forces io_rdata for fault injection; the
// force counts as a second driver of the always_comb output.
lint_off -rule MULTIDRIVEN -file "*/src/rtl/serial/n2m_serial.sv" -match "*'io_rdata'"
