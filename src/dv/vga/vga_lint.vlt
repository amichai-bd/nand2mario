`verilator_config
// Lint waivers for warnings the VGA testbenches induce in src/rtl.
// Each waiver names the rule, the RTL file and signal, and the testbench
// construct that causes the report. RTL lint comments stay reserved for
// warnings the RTL itself owns. A comment here must not open with the word
// "verilator": the lexer would read it as a lint meta-comment.

// MULTIDRIVEN: tb_vga forces writer_bank for its bank-reuse fault and
// display_bank for its active-swap fault; each force counts as a second
// driver of the register.
lint_off -rule MULTIDRIVEN -file "*/src/rtl/vga/n2m_frame_bridge.sv" -match "*'writer_bank'"
lint_off -rule MULTIDRIVEN -file "*/src/rtl/vga/n2m_frame_bridge.sv" -match "*'display_bank'"
