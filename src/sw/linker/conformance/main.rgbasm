; Original relocation fixture: independent of opcode tables and linker output.
SECTION "code", ROM0[$0200]
Start: LD A,ByteLow
LD B,ByteHigh
LD BC,WordLow
LD DE,WordHigh
LDH A,[HighMem]
BIT BitSeven,A
RES BitZero,B
RST VectorFirst
RST VectorLast
DW Partner
DB LOW(Partner),HIGH(Partner)
CALL Partner
EXPORT Start
SECTION "forward", ROM0[$0300]
BranchForward: JR TargetForward
EXPORT BranchForward
SECTION "backward", ROM0[$0400]
BranchBackward: JR TargetBackward
EXPORT BranchBackward
SECTION "work", WRAM0[$c000]
RamBuffer: DS 16
EXPORT RamBuffer
